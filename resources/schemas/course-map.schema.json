{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OEE Workspace course resource mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "curriculum",
    "modules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "notes": {
      "type": "string"
    },
    "curriculum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "course",
        "path"
      ],
      "properties": {
        "repository": {
          "const": "0xbuffdev/open-engineering-education"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "course": {
          "type": "string",
          "pattern": "^[A-Z]{2,4}[1-9][0-9]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "number",
          "title",
          "coverage",
          "resources"
        ],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "enum": [
              "mapped",
              "partial",
              "unmapped"
            ]
          },
          "gap": {
            "type": "string",
            "minLength": 1
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "resource",
                "role",
                "part",
                "purpose",
                "verification"
              ],
              "additionalProperties": false,
              "properties": {
                "resource": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "reference",
                    "practice",
                    "optional"
                  ]
                },
                "part": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "numbers"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "enum": [
                            "chapters",
                            "projects"
                          ]
                        },
                        "numbers": {
                          "type": "array",
                          "minItems": 1,
                          "uniqueItems": true,
                          "items": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "titles"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "enum": [
                            "section-titles",
                            "topics"
                          ]
                        },
                        "titles": {
                          "type": "array",
                          "minItems": 1,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "start",
                        "end"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "section-range"
                        },
                        "start": {
                          "type": "string",
                          "minLength": 1
                        },
                        "end": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                },
                "verification": {
                  "enum": [
                    "verified",
                    "review-needed"
                  ]
                },
                "lesson": {
                  "type": "object",
                  "required": [
                    "number",
                    "title"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
