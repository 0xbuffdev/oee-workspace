#!/usr/bin/env bash

# WS-I12: resolve project course type through the OEE Toolkit, not aliases.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: new-project-workspace <project-course-code> [workspace-dir]

Creates learner-owned project files only for OEE v0.2.0 courses whose
canonical Type is project (for example SEF10 or SEC9).

Environment:
  OEE_REPO        Local OEE checkout (default: sibling directory).
  OEE_WORKSPACE   Existing destination (default: current directory).

Requires Git and Python 3.11+ with the first-party OEE Toolkit.
EOF
}

if [[ "$#" -lt 1 || "$#" -gt 2 ]]; then
  usage
  exit 64
fi

course="$1"
if ! [[ "$course" =~ ^(SEF|APP|SYS|AI|SEC)[1-9][0-9]*$ ]]; then
  echo "Invalid OEE project course code: $course" >&2
  usage
  exit 64
fi
program="${BASH_REMATCH[1]}"

workspace_repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
default_oee_repo="$(dirname "$workspace_repo_root")/open-engineering-education"
oee_repo="${OEE_REPO:-$default_oee_repo}"

if [[ ! -f "$oee_repo/tooling/oee_toolkit/__main__.py" ]]; then
  echo "OEE Toolkit checkout not found: $oee_repo" >&2
  echo "Set OEE_REPO to a local OEE checkout with the first-party Toolkit." >&2
  exit 1
fi
oee_repo="$(cd "$oee_repo" && pwd)"

if ! revision="$(git -C "$oee_repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null)"; then
  echo "Cannot resolve a source commit in $oee_repo" >&2
  exit 1
fi
if ! [[ "$revision" =~ ^[0-9a-f]{40}$ ]]; then
  echo "OEE revision must be a complete lowercase commit SHA." >&2
  exit 1
fi

# Export from exactly the selected Git commit, using OEE's single parser.
if ! export_json="$(
  cd "$oee_repo"
  python3 -m tooling.oee_toolkit export --repo . \
    --revision "$revision" --course "$course" --output -
)"; then
  echo "Could not validate OEE project source: $course" >&2
  exit 1
fi
if ! source_type="$(printf '%s' "$export_json" | python3 -c \
  'import json,sys; print(json.load(sys.stdin)["course"]["type"])')"; then
  echo "OEE Toolkit returned an invalid course export." >&2
  exit 1
fi
if [[ "$source_type" != project ]]; then
  echo "OEE course $course has Type '$source_type', not 'project'." >&2
  exit 64
fi

workspace="${2:-${OEE_WORKSPACE:-.}}"
if [[ -L "$workspace" || ! -d "$workspace" ]]; then
  echo "Workspace directory does not exist: $workspace" >&2
  exit 1
fi
workspace="$(cd "$workspace" && pwd)"
if [[ "$workspace" == "$oee_repo" || "$workspace" == "$workspace_repo_root" ]]; then
  echo "Refusing to create learner work inside the OEE repository." >&2
  exit 1
fi

template_dir="$workspace_repo_root/templates/project-workspace"
for template in README.md design.md evaluation.md retrospective.md; do
  if [[ ! -f "$template_dir/$template" ]]; then
    echo "Required template not found: $template_dir/$template" >&2
    exit 1
  fi
done

# Build the complete project tree before any learner destination is visible.
source_path="curriculum/$program/$course.md"
source_link="https://github.com/0xbuffdev/open-engineering-education/blob/$revision/$source_path"
staging="$(mktemp -d "$workspace/.oee-stage-$course.XXXXXXXX")"
cleanup() {
  if [[ -n "${staging:-}" && -d "$staging" ]]; then
    rm -rf -- "$staging"
  fi
}
trap cleanup EXIT
project_dir="$staging/projects/$course"
mkdir -p "$project_dir/docs"

sed -e "s|<project_title>|$course|g" \
    -e "s|<brief_link>|$source_link|g" \
    "$template_dir/README.md" > "$project_dir/README.md"
for template in design.md evaluation.md retrospective.md; do
  sed -e "s|<project_title>|$course|g" \
      -e "s|<brief_link>|$source_link|g" \
      "$template_dir/$template" > "$project_dir/docs/$template"
done

cat > "$project_dir/BRIEF.md" <<EOF
# $course project workspace

**Canonical OEE course:** [$course]($source_link)
**OEE source revision:** $revision

This course owns its outcomes, assessed work, public criteria and required
evidence. This workspace organizes learner work and does not redefine the
project. Read the canonical source and its assessment requirements before work.

Track actual evidence and review decisions in [progress.md](../../progress.md).
EOF

python3 "$workspace_repo_root/scripts/publish-workspace.py" \
  --workspace "$workspace" --stage "$staging" --project "$course"

echo "Created $course project workspace: $workspace/projects/$course"
echo "Canonical source: $source_link"
echo "Check the actual course's assessment and authorization requirements."
