#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: new-course-workspace <program> <course-code> [workspace-dir]

Creates a course workspace using templates from oee-workspace and validates
the course against a local Open Engineering Education checkout.

Arguments:
  program        SEF | APP | SYS | AI | SEC
  course-code    e.g. F0, S1, AI6, D1
  workspace-dir  destination; defaults to $OEE_WORKSPACE, then current dir

Environment:
  OEE_REPO                Path to the local OEE repository.
  OEE_WORKSPACE           Default destination for generated files.
  OEE_CURRICULUM_URL      Base URL for OEE course links.

By default, OEE_REPO is ../open-engineering-education relative to this
workspace repository.
EOF
}

if [[ "$#" -lt 2 || "$#" -gt 3 ]]; then
  usage
  exit 64
fi

program="$1"
course="$2"

# Course-code prefixes match the current course files; APP courses are not
# yet published. Update this mapping together with the curriculum.
case "$program" in
  SEF) prefix="F" ;;
  APP) prefix="A" ;;
  SYS) prefix="S" ;;
  AI)  prefix="AI" ;;
  SEC) prefix="D" ;;
  *)
    echo "Unknown program: $program" >&2
    echo "Choose one of: SEF, APP, SYS, AI, SEC" >&2
    exit 64
    ;;
esac

if ! [[ "$course" =~ ^${prefix}[0-9]+$ ]]; then
  echo "Invalid course code '$course' for program '$program'." >&2
  echo "Expected ${prefix} followed by a number." >&2
  exit 64
fi

workspace_repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
default_oee_repo="$(dirname "$workspace_repo_root")/open-engineering-education"
oee_repo="${OEE_REPO:-$default_oee_repo}"

if [[ ! -d "$oee_repo/curriculum/$program" ]]; then
  echo "OEE curriculum directory not found:" >&2
  echo "  $oee_repo/curriculum/$program" >&2
  echo "Set OEE_REPO to the root of your local OEE checkout." >&2
  exit 1
fi

oee_repo="$(cd "$oee_repo" && pwd)"

course_dir="$oee_repo/curriculum/$program"

shopt -s nullglob
matches=("$course_dir/$course"-*.md)
shopt -u nullglob

if [[ "${#matches[@]}" -ne 1 ]]; then
  echo "Course '$course' was not found uniquely in $course_dir." >&2
  echo "Expected exactly one file matching '$course-*.md'." >&2
  exit 64
fi

course_file="${matches[0]}"
course_name="$(basename "$course_file")"

oee_url="${OEE_CURRICULUM_URL:-https://github.com/0xbuffdev/open-engineering-education/blob/main}"
course_link="$oee_url/curriculum/$program/$course_name"

workspace="${3:-${OEE_WORKSPACE:-.}}"

if [[ ! -d "$workspace" ]]; then
  echo "Workspace directory does not exist: $workspace" >&2
  exit 1
fi

workspace="$(cd "$workspace" && pwd)"

if [[ "$workspace" == "$oee_repo" ]]; then
  echo "Refusing to create learner files inside the canonical OEE repository." >&2
  echo "Run this from your own workspace or supply its directory." >&2
  exit 1
fi

template_dir="$workspace_repo_root/templates/course-workspace"

required_templates=(
  "lab-README.md"
  "exercises-README.md"
  "resources.md"
  "summary.md"
)

for template in "${required_templates[@]}"; do
  if [[ ! -f "$template_dir/$template" ]]; then
    echo "Required template not found: $template_dir/$template" >&2
    exit 1
  fi
done

lab_dir="$workspace/labs/$program/$course"
exercise_dir="$workspace/exercises/$program/$course"
notes_dir="$workspace/notes/$program/$course"

for destination in "$lab_dir" "$exercise_dir" "$notes_dir"; do
  if [[ -e "$destination" ]]; then
    echo "Workspace destination already exists: $destination" >&2
    echo "Nothing has been overwritten." >&2
    exit 1
  fi
done

mkdir -p "$lab_dir" "$exercise_dir" "$notes_dir"

for template_and_destination in \
  "lab-README.md:$lab_dir/README.md" \
  "exercises-README.md:$exercise_dir/README.md" \
  "resources.md:$notes_dir/resources.md" \
  "summary.md:$notes_dir/summary.md"; do

  template="${template_and_destination%%:*}"
  destination="${template_and_destination#*:}"

  sed \
    -e "s|<course>|$course|g" \
    -e "s|<course_link>|$course_link|g" \
    "$template_dir/$template" > "$destination"
done

echo "Created workspace for $course in $workspace:"
echo "  labs/$program/$course/"
echo "  exercises/$program/$course/"
echo "  notes/$program/$course/"
echo "Course definition: $course_link"
