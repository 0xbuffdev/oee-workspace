#!/usr/bin/env bash
# WS-I04: validate, stage and publish without overwriting learner work.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: new-course-workspace <program> <course-code> [workspace-dir]

Create a learner workspace for a canonical OEE v0.2.0 course.
Only source-pinned, reviewed v2 resource maps generate reading plans.

Environment:
  OEE_REPO       Local OEE checkout (default: sibling directory).
  OEE_WORKSPACE  Existing learner destination (default: current directory).

Requires Git and Python 3.11+ with the first-party OEE Toolkit.
EOF
}
if [[ "$#" -lt 2 || "$#" -gt 3 ]]; then usage; exit 64; fi
program="$1"
course="$2"
case "$program" in
  SEF|APP|SYS|AI|SEC) ;;
  *) echo "Unknown OEE program: $program" >&2; exit 64 ;;
esac
if ! [[ "$course" =~ ^${program}[1-9][0-9]*$ ]]; then
  echo "Invalid course code '$course' for $program." >&2
  exit 64
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
oee_repo="${OEE_REPO:-$(dirname "$repo_root")/open-engineering-education}"
if [[ ! -f "$oee_repo/tooling/oee_toolkit/__main__.py" ]]; then
  echo "OEE Toolkit checkout missing: $oee_repo" >&2
  exit 1
fi
oee_repo="$(cd "$oee_repo" && pwd)"
workspace="${3:-${OEE_WORKSPACE:-.}}"
if [[ -L "$workspace" || ! -d "$workspace" ]]; then
  echo "Learner workspace must be a real existing directory: $workspace" >&2
  exit 1
fi
workspace="$(cd "$workspace" && pwd)"
if [[ "$workspace" == "$oee_repo" || "$workspace" == "$repo_root" ]]; then
  echo "Refusing to generate learner work inside a canonical source repository." >&2
  exit 1
fi

templates="$repo_root/templates/course-workspace"
for name in lab-README.md exercises-README.md resources.md summary.md; do
  if [[ ! -f "$templates/$name" ]]; then
    echo "Required template missing: $templates/$name" >&2
    exit 1
  fi
done

mapping="$repo_root/resources/mappings/$program/$course.json"
if [[ -L "$mapping" ]]; then
  echo "Refusing symlinked map: $mapping" >&2
  exit 1
fi
mapped=0
if [[ -f "$mapping" ]]; then
  mapped=1
  if ! revision="$(python3 - "$mapping" "$course" <<'PY'
import json, re, sys
from pathlib import Path
item = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
source = item["curriculum"]
if item.get("schemaVersion") != 2 or item.get("status") != "reviewed":
    raise SystemExit("unreviewed_map: only reviewed v2 maps may be published")
if source.get("course") != sys.argv[2] or source.get("specification") != "v0.2.0":
    raise SystemExit("invalid mapped course or specification")
revision = source.get("revision")
if not isinstance(revision, str) or not re.fullmatch(r"[0-9a-f]{40}", revision):
    raise SystemExit("invalid full commit SHA")
print(revision)
PY
)"; then
    echo "Refusing unreviewed or unsupported mapped source." >&2
    exit 1
  fi
  python3 "$repo_root/scripts/check-resources.py" \
    --oee "$oee_repo" --course "$course"
else
  if ! revision="$(git -C "$oee_repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null)"; then
    echo "Cannot resolve an OEE source commit." >&2
    exit 1
  fi
fi
if ! [[ "$revision" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Source revision must be a full lowercase commit SHA." >&2
  exit 1
fi
if ! (
  cd "$oee_repo"
  python3 -m tooling.oee_toolkit export --repo . \
    --revision "$revision" --course "$course" --output - >/dev/null
); then
  echo "OEE Toolkit rejected $course at $revision" >&2
  exit 1
fi
course_link="https://github.com/0xbuffdev/open-engineering-education/blob/$revision/curriculum/$program/$course.md"

# Every file is rendered under a private staging directory first.
stage="$(mktemp -d "$workspace/.oee-stage-$program-$course.XXXXXXXX")"
cleanup() {
  if [[ -n "${stage:-}" && -d "$stage" ]]; then rm -rf -- "$stage"; fi
}
trap cleanup EXIT
mkdir -p "$stage/labs/$program/$course" "$stage/exercises/$program/$course" "$stage/notes/$program/$course"
for pair in \
  "lab-README.md:$stage/labs/$program/$course/README.md" \
  "exercises-README.md:$stage/exercises/$program/$course/README.md" \
  "resources.md:$stage/notes/$program/$course/resources.md" \
  "summary.md:$stage/notes/$program/$course/summary.md"; do
  source="${pair%%:*}"
  destination="${pair#*:}"
  sed -e "s|<course>|$course|g" -e "s|<course_link>|$course_link|g" \
    "$templates/$source" > "$destination"
done
if [[ "$mapped" -eq 1 ]]; then
  python3 "$repo_root/scripts/render-resource-guides.py" \
    --oee "$oee_repo" --course "$course" --stdout \
    > "$stage/notes/$program/$course/reading-plan.md"
fi

python3 "$repo_root/scripts/publish-workspace.py" \
  --workspace "$workspace" --stage "$stage" --course "$program" "$course"
echo "Created course workspace for $course in $workspace"
echo "Canonical OEE source: $course_link"
if [[ "$mapped" -eq 1 ]]; then
  echo "Reviewed pinned reading plan: notes/$program/$course/reading-plan.md"
else
  echo "No reviewed public resource guide mapped for $course."
fi
